      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (method, controller, action) (rate(http_requests_received_total{job=\"orders-api-dotnet\"}[1m]))",
          "legendFormat": "{{method}} {{controller}}/{{action}}",
          "refId": "A"
        }
      ],
      "title": "Taxa de Requisições por Endpoint (req/s, rate[1m])",
      "type": "timeseries"
