{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "BullBoard": {
    "BaseUrl": "http://bull-board-app:4000"
  },
  "RabbitMq": {
    "ConnectionString": "amqp://rabbitmq",
    "OrdersQueue": "orders_queue",
    "Exchange": "orders-api-failures-exchange",
    "GetQueue": "orders-api-failures-get",
    "PostQueue": "orders-api-failures-post",
    "GetRoutingKey": "orders.get.error",
    "PostRoutingKey": "orders.post.error"
  },
  "Resilience": {
    "DbPoolDegradedModeSeconds": 60
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Database=OrdersDb;User=sa;Password=Your_strong_password123;TrustServerCertificate=True;Max Pool Size=100;Min Pool Size=10;Connection Lifetime=300;"
  },
  "Mongo": {
    "ConnectionString": "mongodb://mongo:27017",
    "Database": "logs",
    "Collection": "app_logs"
  },
  "ApplicationName": "OrdersApi"
}
